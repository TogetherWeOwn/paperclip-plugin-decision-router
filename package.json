{
  "name": "@togetherweown/paperclip-decision-router",
  "version": "0.1.0",
  "description": "Paperclip plugin: no approval request sits unanswered. Routes every Decisions-page item (interactions, recovery, blocker, review, failed-run, approval) deterministically or to the CEO desk.",
  "license": "MIT",
  "keywords": [],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TogetherWeOwn/paperclip-plugin-decision-router.git"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/GAPS.md",
    "docs/SLA_METRICS.md",
    "docs/SHADOW.md",
    "docs/GRAMMAR.md"
  ],
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "2026.817.0",
    "@paperclipai/shared": "2026.817.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
